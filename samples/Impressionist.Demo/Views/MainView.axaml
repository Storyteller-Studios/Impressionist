<UserControl
    x:Class="Impressionist.Demo.Views.MainView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Impressionist.Demo.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Impressionist.Demo.ViewModels"
    d:DesignHeight="450"
    d:DesignWidth="800"
    x:DataType="vm:MainViewModel"
    mc:Ignorable="d">
    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Grid
        Margin="16"
        RowDefinitions="Auto,Auto,*,Auto"
        RowSpacing="16">

        <TextBlock
            FontSize="24"
            FontWeight="SemiBold"
            Text="Quantizer Demo" />

        <StackPanel
            Grid.Row="1"
            Orientation="Horizontal"
            Spacing="12">
            <Button
                Name="OpenImageButton"
                Click="OpenImageButton_OnClick"
                Content="打开图片" />
            <NumericUpDown
                Maximum="64"
                Minimum="1"
                Value="{Binding ColorsCount, Mode=TwoWay}" />
            <Button Command="{Binding QuantizeCommand}" Content="Quantize" />
        </StackPanel>

        <Grid
            Grid.Row="2"
            ColumnDefinitions="2*,*"
            ColumnSpacing="16">
            <Border
                Name="DropArea"
                Grid.Column="0"
                Background="{DynamicResource ButtonBackground}">
                <controls:ShaderEffectControl
                    x:Name="ShaderControl"
                    Colors="{Binding Colors}"
                    IsEnableAnimation="True"
                    PerformanceMode="HighQuality" />
            </Border>

            <Border
                Grid.Column="1"
                Padding="12"
                BorderBrush="{DynamicResource ThemeControlMidBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <ScrollViewer>
                    <StackPanel Spacing="8">
                        <Image Source="{Binding Image, Mode=OneWay}" Stretch="Uniform" />
                        <ItemsControl ItemsSource="{Binding ColorItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:MainViewModel+QuantizedColorItem">
                                    <StackPanel Spacing="8">
                                        <Border
                                            Height="32"
                                            Background="{Binding Brush}"
                                            CornerRadius="6" />
                                        <TextBlock HorizontalAlignment="Center" Text="{Binding Hex}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
